# Copy this file to scripts/backup.env and edit the values for your host.
# scripts/backup.env is gitignored so host-specific paths aren't committed.

# Docker container running Postgres (see docker-compose.yml container_name)
DB_CONTAINER=tsi_compass_db

# Must match POSTGRES_DB / POSTGRES_USER used to start the stack (.env or docker-compose defaults)
POSTGRES_DB=tsi_compass
POSTGRES_USER=tsi_admin

# Where the dump is staged locally before being copied to BACKUP_DEST_DIR
LOCAL_BACKUP_DIR=/home/tsi/work

# Destination directory backups are copied to (a NAS mount, external drive,
# or any other mounted/local path). Must already exist.
# Optional: if unset, backups stay in LOCAL_BACKUP_DIR only (not copied
# off-host) and the script prints a warning.
BACKUP_DEST_DIR=/home/tsi/work

# How many days of backups to keep, in both LOCAL_BACKUP_DIR and BACKUP_DEST_DIR
RETENTION_DAYS=14

# Also archive the tsi_reports_data docker volume? This holds all
# uploaded files (policy documents, audit evidence, ticket attachments,
# change-request attachments) as well as generated report exports.
# Defaults to true (in backup.sh) since this is user data, same as the
# database. EXPORTS_VOLUME must match the actual volume name — check
# with `docker volume ls`; it's normally <compose-project-name>_tsi_reports_data.
INCLUDE_EXPORTS=true
EXPORTS_VOLUME=tsi-compass_tsi_reports_data
